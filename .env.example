# Copy this file to .env and adjust as needed.

APP_NAME=LaptopSathi AI
ENV=development

# SQLite for dev (default). For production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/laptopsathi
DATABASE_URL=sqlite:///./data/laptopsathi.db

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Hybrid recommendation weights (should sum to ~1.0)
WEIGHT_SEMANTIC=0.30
WEIGHT_BUDGET=0.20
WEIGHT_COMPATIBILITY=0.20
WEIGHT_BENCHMARK=0.15
WEIGHT_BRAND_PREF=0.05
WEIGHT_FUTURE_PROOF=0.10

# --- Production checklist ---
# 1. JWT_SECRET_KEY: MUST be overridden to a unique random secret before any
#    public deployment. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
#    Leaving the default lets anyone forge valid login tokens.
JWT_SECRET_KEY=dev-only-change-me-in-production-6f8a9c2e1b7d4f0a

# 2. CORS_ORIGINS: restrict to your real frontend origin(s) in production.
#    Comma-separated is fine, e.g.: https://laptopsathi.ai,https://www.laptopsathi.ai
#    "*" (the default) is only appropriate for local development.
CORS_ORIGINS=*

# 3. Auto-bootstrap: on startup, if the `laptops` table is empty, the app will
#    automatically ingest the newest file in data/raw/ and build the search
#    index — this is what makes `docker compose up` (or a fresh clone) work
#    end-to-end without manually running the setup scripts. Set to false once
#    you manage the knowledge base entirely through the admin API/UI.
AUTO_BOOTSTRAP_KB=true

# 4. First admin user: only read by docker-entrypoint.sh (which calls
#    scripts/seed_auth.py). Not required for a bare `uvicorn` run — for that,
#    run `python scripts/seed_auth.py --admin-email ... --admin-password ...` yourself.
# ADMIN_EMAIL=admin@laptopsathi.ai
# ADMIN_PASSWORD=ChangeMe123!

# 5. Registration email OTP: no key/secret needed — codes are generated
#    randomly and only a SHA-256 hash is stored. Tune expiry/attempt limits
#    via REGISTRATION_OTP_EXPIRE_MINUTES / MAX_REGISTRATION_OTP_ATTEMPTS in
#    app/config.py if the defaults (10 minutes, 5 attempts) don't fit.

# 6. SMTP: without this, no real email is sent — registration OTPs and
#    password-reset links only appear in the server logs (fine for local
#    dev, useless for real users). Fill these in to actually deliver email.
#    Works with any SMTP-speaking provider; a few common setups:
#
#    Gmail (quick testing only — use a 16-char "App Password", not your
#    real password: https://myaccount.google.com/apppasswords, requires
#    2-Step Verification on the Google account):
#      SMTP_HOST=smtp.gmail.com
#      SMTP_PORT=587
#      SMTP_USERNAME=you@gmail.com
#      SMTP_PASSWORD=<16-char app password>
#
#    SendGrid:
#      SMTP_HOST=smtp.sendgrid.net
#      SMTP_PORT=587
#      SMTP_USERNAME=apikey
#      SMTP_PASSWORD=<your SendGrid API key>
#
#    Mailgun:
#      SMTP_HOST=smtp.mailgun.org
#      SMTP_PORT=587
#      SMTP_USERNAME=postmaster@<your-mailgun-domain>
#      SMTP_PASSWORD=<your Mailgun SMTP password>
#
#    Amazon SES:
#      SMTP_HOST=email-smtp.<your-region>.amazonaws.com
#      SMTP_PORT=587
#      SMTP_USERNAME=<SES SMTP username, from the SES console>
#      SMTP_PASSWORD=<SES SMTP password, from the SES console>
#
#    Postmark:
#      SMTP_HOST=smtp.postmarkapp.com
#      SMTP_PORT=587
#      SMTP_USERNAME=<Postmark Server API token>
#      SMTP_PASSWORD=<same Postmark Server API token>
#
#    In every case above, also set SMTP_FROM_EMAIL to an address/domain
#    you've verified with that provider — most providers reject or spam-
#    filter mail from an unverified sender.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@laptopsathi.ai
SMTP_FROM_NAME=LaptopSathi AI

